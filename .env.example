# .env.example — commit this
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
PERSONA_DB_PATH=./data/db/persona.db
CHROMA_PATH=./data/db/chroma
LOG_LEVEL=INFO

# Phase 3 — GIF search (optional)
# Tenor was shut down 2026-06-30. Use Giphy instead.
# Free API key (takes ~2 min): https://developers.google.com/tenor → NO, use:
# https://developers.giphy.com/dashboard/  → Create App → API → copy key
# Without this key, GIF search returns empty — emoji suggestions still work fully.
GIPHY_API_KEY=your_giphy_api_key_here
